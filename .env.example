# "Ask" chat panel. Any OpenAI-compatible chat API works.
# Default: OpenRouter's free models router, key from https://openrouter.ai/settings/keys
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated; later models are fallbacks when one is overloaded or rate limited.
# Default: a cheap paid model, then the free router. Each answer sends ~12k tokens of
# portfolio context, so set a monthly credit limit on the OpenRouter key to cap spend.
# LLM_MODEL=anthropic/claude-haiku-5.5,openrouter/free
# Free only: LLM_MODEL=openrouter/free

# Alternatives with free tiers:
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
