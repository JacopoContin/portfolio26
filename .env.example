# "Ask" chat panel. Any OpenAI-compatible chat API works.
# Default: Google Gemini free tier, key from https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest  (alias for the newest Flash model)

# Alternatives with free tiers:
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<any model ending in :free>
